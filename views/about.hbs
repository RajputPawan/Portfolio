<section>
  <h1>About {{siteMeta.name}}</h1>
  <p class="lead">{{siteMeta.description}}</p>
</section>

<section class="timeline">
  {{#each timeline}}
    <article>
      <header>
        <strong>{{this.title}}</strong>
        <span>{{this.org}} &bull; {{this.period}}</span>
      </header>
      <p>{{this.details}}</p>
    </article>
  {{/each}}
</section>
