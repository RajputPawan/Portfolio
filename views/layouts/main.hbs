<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} - My Portfolio</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100">
    <nav class="bg-white shadow-lg">
        <div class="max-w-6xl mx-auto px-4">
            <div class="flex justify-between">
                <div class="flex space-x-7">
                    <div>
                        <a href="/" class="flex items-center py-4 px-2">
                            <span class="font-semibold text-gray-500 text-lg">My Portfolio</span>
                        </a>
                    </div>
                    <div class="hidden md:flex items-center space-x-1">
                        <a href="/" class="py-4 px-2 {{#if (eq active 'home')}}text-blue-500 border-b-4 border-blue-500{{else}}text-gray-500 hover:text-blue-500{{/if}}">Home</a>
                        <a href="/about" class="py-4 px-2 {{#if (eq active 'about')}}text-blue-500 border-b-4 border-blue-500{{else}}text-gray-500 hover:text-blue-500{{/if}}">About</a>
                        <a href="/projects" class="py-4 px-2 {{#if (eq active 'projects')}}text-blue-500 border-b-4 border-blue-500{{else}}text-gray-500 hover:text-blue-500{{/if}}">Projects</a>
                        <a href="/contact" class="py-4 px-2 {{#if (eq active 'contact')}}text-blue-500 border-b-4 border-blue-500{{else}}text-gray-500 hover:text-blue-500{{/if}}">Contact</a>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <main class="container mx-auto px-4 py-8">
        {{{body}}}
    </main>

    <footer class="bg-white shadow-lg mt-8">
        <div class="max-w-6xl mx-auto px-4 py-6">
            <p class="text-center text-gray-600">© {{currentYear}} My Portfolio. All rights reserved.</p>
        </div>
    </footer>

    <script>
        // Add current year to footer
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelector('footer p').innerHTML = `© ${new Date().getFullYear()} My Portfolio. All rights reserved.`;
        });
    </script>
</body>
</html>
