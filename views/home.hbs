<section class="hero">
  <hgroup>
    <h1>{{hero.heading}}</h1>
    <p>{{hero.subheading}}</p>
  </hgroup>
  <div class="cta">
    <a role="button" href="{{hero.ctaPrimary.href}}">{{hero.ctaPrimary.label}}</a>
    <a role="button" class="secondary" href="{{hero.ctaSecondary.href}}">{{hero.ctaSecondary.label}}</a>
  </div>
</section>

<section class="grid skills">
  {{#each skills}}
    <article>
      <h3>{{this.title}}</h3>
      <p>{{this.description}}</p>
    </article>
  {{/each}}
</section>
