[flake8]
# Set the maximum line length to 127 characters
max-line-length = 127

# Ignore specific error codes
# E302: expected 2 blank lines before function definition
# E305: expected 2 blank lines after class or function definition
ignore = E302, E305

# Set the maximum complexity of functions (default is 10)
max-complexity = 10

# Exclude directories and files
exclude = .git,__pycache__,venv,env,.venv,build,dist

# Allow inline comments on the same line as code
inline-quotes = single

# Allow unused variables (useful for function parameters that might be used later)
per-file-ignores =
    # Allow unused 'app' in app.py
    app.py: F841

[pycodestyle]
# Allow 1 blank line around functions instead of 2
blank_lines_around_top_level_definition = 1
